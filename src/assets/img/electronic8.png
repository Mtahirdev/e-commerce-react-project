								</svg>
							</div>
						</div>
						
						
						
							
							
								<p class="text-field-v2__text error" id="getstock-popup-error-txt">Please double check your email address.</p>
							
						
					</div>
				</div>
				
            	
				<div class="pd-get-stock-alert-popup__checkbox-container">
              		
					
					
					
					
					
						
					
					
					
					
				</div>
				
				
					
					
